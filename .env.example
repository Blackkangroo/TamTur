# SmartLead AI - ortam değişkenleri ÖRNEĞİ
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# ".env" dosyası .gitignore'dadır; GitHub'a ASLA yüklenmez.

# Çalışma modu: development (hata ayıklama açık) veya production (Render'da)
FLASK_ENV=development

# Flask'ın oturum/çerez imzalama anahtarı. Üretimde uzun ve rastgele bir değer verin.
SECRET_KEY=gelistirme-icin-gecici-anahtar

# SQLite veritabanı dosyasının yolu. Göreli verilirse proje köküne göre çözülür.
DATABASE_URL=smartlead.db

# Groq API anahtarı (console.groq.com -> gsk_... ile başlar).
# BOŞ bırakılırsa uygulama çökmez, "demo modu" cevabı döner.
GROQ_API_KEY=

# Yapay zekâ sağlayıcısı ve model adı (yönergede verilen model)
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b

# CORS: hangi sitelerin API'ye tarayıcıdan istek atabileceği.
# "*" herkese açık demektir; Wix sitenizin adresini virgülle ayırarak yazabilirsiniz.
# Yalnızca şema + alan adı yazılır; /sitem gibi sayfa yolu YAZILMAZ (tarayıcı Origin
# başlığında yol göndermez, yol eklenirse adres hiç eşleşmez):
#   CORS_ORIGINS=https://kullanici.wixsite.com,https://www.siteniz.com
CORS_ORIGINS=*

# Sunucunun dinleyeceği port (Render kendi PORT değerini verir)
PORT=5000

# NOT: İşletme adı / slogan / BUSINESS_CONTEXT burada DEĞİL, config.py içindedir.
